-- Consolidated interactions schema migration
-- This combines multiple small migrations into one clean migration

-- 1. Add voting support to interactions
ALTER TABLE public.interactions 
ADD COLUMN IF NOT EXISTS voting_ends_at TIMESTAMPTZ NULL,
ADD COLUMN IF NOT EXISTS voting_seconds INTEGER DEFAULT 300;

-- 2. Add answer timer support to interactions  
ALTER TABLE public.interactions 
ADD COLUMN IF NOT EXISTS answer_ends_at TIMESTAMPTZ NULL,
ADD COLUMN IF NOT EXISTS answer_seconds INTEGER DEFAULT 300;

-- 3. Update status constraint to include all phases
ALTER TABLE public.interactions DROP CONSTRAINT IF EXISTS interactions_status_check;

ALTER TABLE public.interactions 
ADD CONSTRAINT interactions_status_check 
CHECK (status IN ('active', 'voting', 'results', 'closed'));

-- 4. Fix RLS policies for interaction_votes
DROP POLICY IF EXISTS "Users can view votes for their room" ON public.interaction_votes;
DROP POLICY IF EXISTS "Users can insert votes for their room" ON public.interaction_votes;
DROP POLICY IF EXISTS "Users can update their own votes" ON public.interaction_votes;

CREATE POLICY "Users can view votes for their room" ON public.interaction_votes
  FOR SELECT USING (
    EXISTS (
      SELECT 1 FROM public.room_memberships rm
      WHERE rm.room_id = (
        SELECT room_id FROM public.interactions 
        WHERE id = interaction_votes.interaction_id
      )
      AND rm.user_id = auth.uid()
    )
  );

CREATE POLICY "Users can insert votes for their room" ON public.interaction_votes
  FOR INSERT WITH CHECK (
    EXISTS (
      SELECT 1 FROM public.room_memberships rm
      WHERE rm.room_id = (
        SELECT room_id FROM public.interactions 
        WHERE id = interaction_votes.interaction_id
      )
      AND rm.user_id = auth.uid()
    )
  );

CREATE POLICY "Users can update their own votes" ON public.interaction_votes
  FOR UPDATE USING (membership_id = auth.uid());

-- 5. Fix RLS policies for interaction_responses
DROP POLICY IF EXISTS "Users can view responses for their room" ON public.interaction_responses;
DROP POLICY IF EXISTS "Users can insert responses for their room" ON public.interaction_responses;
DROP POLICY IF EXISTS "Users can update their own responses" ON public.interaction_responses;

CREATE POLICY "Users can view responses for their room" ON public.interaction_responses
  FOR SELECT USING (
    EXISTS (
      SELECT 1 FROM public.room_memberships rm
      WHERE rm.room_id = (
        SELECT room_id FROM public.interactions 
        WHERE id = interaction_responses.interaction_id
      )
      AND rm.user_id = auth.uid()
    )
  );

CREATE POLICY "Users can insert responses for their room" ON public.interaction_responses
  FOR INSERT WITH CHECK (
    EXISTS (
      SELECT 1 FROM public.room_memberships rm
      WHERE rm.room_id = (
        SELECT room_id FROM public.interactions 
        WHERE id = interaction_responses.interaction_id
      )
      AND rm.user_id = auth.uid()
    )
  );

CREATE POLICY "Users can update their own responses" ON public.interaction_responses
  FOR UPDATE USING (membership_id = auth.uid());

-- 6. Create function to advance interaction to voting phase
CREATE OR REPLACE FUNCTION public.advance_interaction_to_voting(p_interaction_id UUID, p_voting_seconds INTEGER DEFAULT 300)
RETURNS BOOLEAN AS $$
BEGIN
  UPDATE public.interactions
  SET 
    status = 'voting',
    voting_ends_at = now() + (p_voting_seconds || ' seconds')::INTERVAL,
    voting_seconds = p_voting_seconds
  WHERE id = p_interaction_id
    AND status = 'active';
  
  RETURN FOUND;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- 7. Create corrected function for auto-advance from active to voting
CREATE OR REPLACE FUNCTION public.advance_interaction_to_voting_on_answer_timeout()
RETURNS TRIGGER AS $$
BEGIN
  -- Only advance if interaction is still in 'active' phase and answer time has expired
  UPDATE public.interactions
  SET 
    status = 'voting',
    voting_ends_at = now() + (COALESCE(answer_seconds, 300) || ' seconds')::INTERVAL,
    voting_seconds = COALESCE(answer_seconds, 300)
  WHERE id = NEW.id
    AND NEW.status = 'active'
    AND NEW.answer_ends_at IS NOT NULL
    AND NEW.answer_ends_at <= now();
  
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- 8. Create trigger to auto-advance when answer time expires
DROP TRIGGER IF EXISTS trigger_advance_to_voting_on_answer_timeout ON public.interactions;
CREATE TRIGGER trigger_advance_to_voting_on_answer_timeout
  AFTER UPDATE ON public.interactions
  FOR EACH ROW
  EXECUTE FUNCTION public.advance_interaction_to_voting_on_answer_timeout();

-- 9. Update existing interactions to use 5-minute timers
UPDATE public.interactions 
SET voting_seconds = 300 
WHERE voting_seconds = 60;

-- Ensure default is 300 for future records
ALTER TABLE public.interactions 
ALTER COLUMN voting_seconds SET DEFAULT 300;
